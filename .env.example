# Copy this file to .env (which is gitignored) and adjust.
#   PowerShell:  Copy-Item .env.example .env

# Required: host folder for everything the tool generates (checkpoint cache, HF cache,
# derived metrics, reports, temp files). It must already exist. Forward slashes work
# on Windows. Pick a drive with a few GB free.
TE_DATA_DIR=D:/trajectory-explorer-data

# Optional: Hugging Face token, only needed for gated or private models.
# HF_TOKEN=
